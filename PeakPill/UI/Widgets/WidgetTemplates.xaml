<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:PeakPill.UI">

    <!-- All widgets are designed for a 150 × 150 "small" widget with 14 px padding. -->

    <!-- Clock -->
    <DataTemplate x:Key="W_Clock">
        <Grid>
            <StackPanel VerticalAlignment="Top">
                <TextBlock Text="{Binding WeekdayText}" Foreground="{StaticResource Danger}" FontSize="11" FontWeight="SemiBold" />
                <TextBlock Text="{Binding DayText}" FontSize="12" Foreground="{StaticResource SubText}" />
            </StackPanel>
            <TextBlock Text="{Binding TimeText}" FontSize="38" FontWeight="Light" FontFamily="{StaticResource DisplayFont}" VerticalAlignment="Bottom" Margin="0,0,0,-4" />
        </Grid>
    </DataTemplate>

    <!-- World clock -->
    <DataTemplate x:Key="W_World">
        <ItemsControl ItemsSource="{Binding WorldClocks}" VerticalAlignment="Center">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding City}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding OffsetText}" FontSize="10" Foreground="{StaticResource SubText}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Time}" FontSize="17" FontFamily="{StaticResource DisplayFont}" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DataTemplate>

    <!-- Weather -->
    <DataTemplate x:Key="W_Weather">
        <Grid>
            <Grid Visibility="{Binding HasData, Converter={StaticResource BoolVis}}">
                <StackPanel VerticalAlignment="Top">
                    <TextBlock Text="{Binding City}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding TempText}" FontSize="38" FontWeight="Light" FontFamily="{StaticResource DisplayFont}" Margin="0,-4,0,0" />
                </StackPanel>
                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock FontSize="12" FontWeight="SemiBold">
                        <Run Text="{Binding Icon, Mode=OneWay}" FontFamily="Segoe UI Symbol" />
                        <Run Text="{Binding Description, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding HighLow}" FontSize="11" Foreground="{StaticResource SubText}" />
                </StackPanel>
            </Grid>
            <StackPanel VerticalAlignment="Center" Visibility="{Binding HasData, Converter={StaticResource InvBoolVis}}">
                <ui:SfIcon Kind="sun" Size="22" Foreground="{StaticResource Yellow}" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{StaticResource SubText}" FontSize="12" Margin="0,6,0,0" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- PC stats: three activity rings -->
    <DataTemplate x:Key="W_Stats">
        <Grid>
            <TextBlock Text="Auslastung" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Top" />
            <UniformGrid Columns="3" VerticalAlignment="Bottom">
                <StackPanel HorizontalAlignment="Center">
                    <ui:Ring Width="36" Height="36" Thickness="5" Value="{Binding Cpu}" Stroke="{StaticResource Accent}" />
                    <TextBlock Text="{Binding CpuText}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    <TextBlock Text="CPU" FontSize="10" Foreground="{StaticResource SubText}" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <ui:Ring Width="36" Height="36" Thickness="5" Value="{Binding Gpu}" Stroke="{StaticResource Green}" />
                    <TextBlock Text="{Binding GpuText}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    <TextBlock Text="GPU" FontSize="10" Foreground="{StaticResource SubText}" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <ui:Ring Width="36" Height="36" Thickness="5" Value="{Binding Ram}" Stroke="{StaticResource Orange}" />
                    <TextBlock Text="{Binding RamPercentText}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    <TextBlock Text="RAM" FontSize="10" Foreground="{StaticResource SubText}" HorizontalAlignment="Center" />
                </StackPanel>
            </UniformGrid>
        </Grid>
    </DataTemplate>

    <!-- Battery -->
    <DataTemplate x:Key="W_Battery">
        <Grid>
            <Grid Visibility="{Binding HasBattery, Converter={StaticResource BoolVis}}">
                <Grid Width="74" Height="74" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0">
                    <ui:Ring Thickness="7" Value="{Binding Battery}" Stroke="{StaticResource Green}" />
                    <ui:SfIcon Kind="bolt" Size="20" Foreground="{StaticResource Green}"
                               Visibility="{Binding Charging, Converter={StaticResource BoolVis}}" />
                    <ui:SfIcon Kind="battery" Size="22"
                               Visibility="{Binding Charging, Converter={StaticResource InvBoolVis}}" />
                </Grid>
                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding BatteryPercentText}" FontSize="17" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding BatteryText}" FontSize="10.5" Foreground="{StaticResource SubText}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasBattery, Converter={StaticResource InvBoolVis}}">
                <Grid Width="74" Height="74">
                    <ui:Ring Thickness="7" Value="100" Stroke="{StaticResource Green}" />
                    <ui:SfIcon Kind="bolt" Size="22" Foreground="{StaticResource Green}" />
                </Grid>
                <TextBlock Text="Netzbetrieb" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- Focus timer -->
    <DataTemplate x:Key="W_Timer">
        <Grid>
            <Grid Width="80" Height="80" HorizontalAlignment="Center" VerticalAlignment="Top">
                <ui:Ring Thickness="6" Value="{Binding RemainingPercent}" Stroke="{StaticResource Orange}" />
                <TextBlock Text="{Binding RemainingText}" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource Orange}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                <Button Style="{StaticResource ChipButton}" Content="{Binding StartPauseText}" Command="{Binding StartPauseCommand}" Background="#40FF9F0A" Foreground="{StaticResource Orange}" />
                <Button Style="{StaticResource ChipButton}" Content="5" Command="{Binding PresetCommand}" CommandParameter="5" Margin="0,0,3,0" />
                <Button Style="{StaticResource ChipButton}" Content="25" Command="{Binding PresetCommand}" CommandParameter="25" Margin="0,0,3,0" />
                <Button Style="{StaticResource SmallIconButton}" ui:Ext.Icon="refresh" ui:Ext.IconSize="12" ui:Ext.Hover="{StaticResource Orange}"
                        Command="{Binding ResetCommand}" ToolTip="Zurücksetzen" Width="22" Height="22" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- To-do (Reminders look) -->
    <DataTemplate x:Key="W_Todo">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="To-do" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Orange}" Margin="0,0,0,4" />
            <TextBox DockPanel.Dock="Top" Style="{StaticResource DarkTextBox}" Tag="Neue Aufgabe" Padding="4,1" MinHeight="22" FontSize="11.5"
                     Text="{Binding NewText, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <ScrollViewer Margin="0,4,0,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Style="{StaticResource RoundCheck}" IsChecked="{Binding Done}" />
                                <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="11.5" Margin="6,0,2,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           TextDecorations="{Binding Done, Converter={StaticResource Strike}}" />
                                <Button Grid.Column="2" Style="{StaticResource SmallIconButton}" ui:Ext.Icon="xmark" ui:Ext.IconSize="9" ui:Ext.Hover="{StaticResource Danger}" Width="18" Height="18"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </DataTemplate>

    <!-- ===================================================================
         Detail parts for the MEDIUM (right of the small part) and LARGE (below it) sizes – 2026-11-16
         =================================================================== -->

    <!-- clock: the world clocks next to it -->
    <DataTemplate x:Key="X_Clock">
        <ItemsControl ItemsSource="{Binding WorldClocks}" VerticalAlignment="Center">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,3">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" FontSize="15" FontFamily="{StaticResource DisplayFont}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding City}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DataTemplate>

    <!-- world clock: today's date big -->
    <DataTemplate x:Key="X_World">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding WeekdayText}" Foreground="{StaticResource Danger}" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Text="{Binding DayText}" FontSize="30" FontWeight="Light" FontFamily="{StaticResource DisplayFont}" />
            <TextBlock Text="{Binding TimeText}" FontSize="12" Foreground="{StaticResource SubText}" />
        </StackPanel>
    </DataTemplate>

    <!-- weather: the next hours -->
    <DataTemplate x:Key="X_Weather">
        <StackPanel VerticalAlignment="Center">
            <ItemsControl ItemsSource="{Binding Hours}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Time}" FontSize="10.5" Foreground="{StaticResource SubText}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Icon}" FontSize="16" FontFamily="Segoe UI Symbol" HorizontalAlignment="Center" Margin="0,3" />
                            <TextBlock Text="{Binding Temp}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel>
    </DataTemplate>

    <!-- PC stats: the numbers in words -->
    <DataTemplate x:Key="X_Stats">
        <StackPanel VerticalAlignment="Center">
            <DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Right" Text="{Binding CpuText}" FontWeight="SemiBold" /><TextBlock Text="Prozessor" Foreground="{StaticResource SubText}" /></DockPanel>
            <DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Right" Text="{Binding GpuText}" FontWeight="SemiBold" /><TextBlock Text="Grafik" Foreground="{StaticResource SubText}" /></DockPanel>
            <DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Right" Text="{Binding RamText}" FontWeight="SemiBold" /><TextBlock Text="Arbeitsspeicher" Foreground="{StaticResource SubText}" /></DockPanel>
        </StackPanel>
    </DataTemplate>

    <!-- battery: in words -->
    <DataTemplate x:Key="X_Battery">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding BatteryPercentText}" FontSize="30" FontWeight="Light" FontFamily="{StaticResource DisplayFont}" />
            <TextBlock Text="{Binding BatteryText}" FontSize="12" Foreground="{StaticResource SubText}" TextWrapping="Wrap" />
        </StackPanel>
    </DataTemplate>

    <!-- focus timer: more lengths -->
    <DataTemplate x:Key="X_Timer">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding ModeText}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
            <WrapPanel>
                <Button Style="{StaticResource ChipButton}" Content="10 Min" Command="{Binding PresetCommand}" CommandParameter="10" Margin="0,0,4,4" />
                <Button Style="{StaticResource ChipButton}" Content="15 Min" Command="{Binding PresetCommand}" CommandParameter="15" Margin="0,0,4,4" />
                <Button Style="{StaticResource ChipButton}" Content="45 Min" Command="{Binding PresetCommand}" CommandParameter="45" Margin="0,0,4,4" />
                <Button Style="{StaticResource ChipButton}" Content="60 Min" Command="{Binding PresetCommand}" CommandParameter="60" Margin="0,0,4,4" />
            </WrapPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ===================================================================
         Compact variants for the flat island (card 128 × 81, 10 px padding)
         =================================================================== -->

    <DataTemplate x:Key="C_Clock">
        <Grid>
            <StackPanel VerticalAlignment="Top">
                <TextBlock Text="{Binding WeekdayText}" Foreground="{StaticResource Danger}" FontSize="9.5" FontWeight="SemiBold" />
                <TextBlock Text="{Binding DayText}" FontSize="10" Foreground="{StaticResource SubText}" />
            </StackPanel>
            <TextBlock Text="{Binding TimeText}" FontSize="24" FontWeight="Light" FontFamily="{StaticResource DisplayFont}" VerticalAlignment="Bottom" Margin="0,0,0,-3" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="C_World">
        <ItemsControl ItemsSource="{Binding WorldClocks}" VerticalAlignment="Center">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding City}" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Time}" FontSize="12" FontFamily="{StaticResource DisplayFont}" Margin="4,0,0,0" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DataTemplate>

    <DataTemplate x:Key="C_Weather">
        <Grid>
            <Grid Visibility="{Binding HasData, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding City}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Top" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding TempText}" FontSize="24" FontWeight="Light" FontFamily="{StaticResource DisplayFont}" VerticalAlignment="Center" Margin="0,4,0,0" />
                <TextBlock Text="{Binding Description}" FontSize="9.5" Foreground="{StaticResource SubText}" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" />
            </Grid>
            <StackPanel VerticalAlignment="Center" Visibility="{Binding HasData, Converter={StaticResource InvBoolVis}}">
                <ui:SfIcon Kind="sun" Size="16" Foreground="{StaticResource Yellow}" HorizontalAlignment="Left" />
                <TextBlock Text="Ort in den Einstellungen festlegen" TextWrapping="Wrap" Foreground="{StaticResource SubText}" FontSize="9.5" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="C_Stats">
        <UniformGrid Columns="3" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <ui:Ring Width="28" Height="28" Thickness="4" Value="{Binding Cpu}" Stroke="{StaticResource Accent}" />
                <TextBlock Text="CPU" FontSize="9" Foreground="{StaticResource SubText}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                <TextBlock Text="{Binding CpuText}" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Center">
                <ui:Ring Width="28" Height="28" Thickness="4" Value="{Binding Gpu}" Stroke="{StaticResource Green}" />
                <TextBlock Text="GPU" FontSize="9" Foreground="{StaticResource SubText}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                <TextBlock Text="{Binding GpuText}" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Center">
                <ui:Ring Width="28" Height="28" Thickness="4" Value="{Binding Ram}" Stroke="{StaticResource Orange}" />
                <TextBlock Text="RAM" FontSize="9" Foreground="{StaticResource SubText}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                <TextBlock Text="{Binding RamPercentText}" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
            </StackPanel>
        </UniformGrid>
    </DataTemplate>

    <DataTemplate x:Key="C_Battery">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid Width="46" Height="46">
                <ui:Ring Thickness="5" Value="{Binding Battery}" Stroke="{StaticResource Green}" Visibility="{Binding HasBattery, Converter={StaticResource BoolVis}}" />
                <ui:Ring Thickness="5" Value="100" Stroke="{StaticResource Green}" Visibility="{Binding HasBattery, Converter={StaticResource InvBoolVis}}" />
                <ui:SfIcon Kind="bolt" Size="16" Foreground="{StaticResource Green}" />
            </Grid>
            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding BatteryPercentText}" FontSize="14" FontWeight="SemiBold" Visibility="{Binding HasBattery, Converter={StaticResource BoolVis}}" />
                <TextBlock Text="Netz" FontSize="12" FontWeight="SemiBold" Visibility="{Binding HasBattery, Converter={StaticResource InvBoolVis}}" />
                <TextBlock Text="{Binding BatteryText}" FontSize="9" Foreground="{StaticResource SubText}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="C_Timer">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid Width="54" Height="54">
                <ui:Ring Thickness="4.5" Value="{Binding RemainingPercent}" Stroke="{StaticResource Orange}" />
                <TextBlock Text="{Binding RemainingText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Orange}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                <Button Style="{StaticResource ChipButton}" Margin="0" Content="{Binding StartPauseText}" Command="{Binding StartPauseCommand}" Background="#40FF9F0A" Foreground="{StaticResource Orange}" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Style="{StaticResource ChipButton}" Content="5" Command="{Binding PresetCommand}" CommandParameter="5" Margin="0,0,3,0" Padding="6,0" />
                    <Button Style="{StaticResource ChipButton}" Content="25" Command="{Binding PresetCommand}" CommandParameter="25" Margin="0" Padding="6,0" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="C_Todo">
        <DockPanel>
            <TextBox DockPanel.Dock="Top" Style="{StaticResource DarkTextBox}" Tag="To-do" Padding="6,0" MinHeight="20" Height="20" FontSize="10.5"
                     Text="{Binding NewText, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <ScrollViewer Margin="0,3,0,0" VerticalScrollBarVisibility="Hidden">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <CheckBox Style="{StaticResource RoundCheck}" IsChecked="{Binding Done}" RenderTransformOrigin="0.5,0.5">
                                    <CheckBox.LayoutTransform>
                                        <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                                    </CheckBox.LayoutTransform>
                                </CheckBox>
                                <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="10.5" Margin="5,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           TextDecorations="{Binding Done, Converter={StaticResource Strike}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </DataTemplate>

</ResourceDictionary>
